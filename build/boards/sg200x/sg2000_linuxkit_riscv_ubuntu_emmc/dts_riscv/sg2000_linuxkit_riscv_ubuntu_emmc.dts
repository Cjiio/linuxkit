/dts-v1/;
#include "soph_base_riscv.dtsi"
#include "soph_asic_bga.dtsi"
#include "soph_asic_emmc.dtsi"
#include "soph_default_memmap.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/input/linux-event-codes.h>

/ {
	model = "Linux-Kit Core";

      wifisd:wifi-sd@4320000 {
            compatible = "cvitek,cv181x-sdio";
            bus-width = <4>;
            reg = <0x0 0x4320000 0x0 0x1000>;
            reg_names = "core_mem";
            src-frequency = <375000000>;
            min-frequency = <400000>; // 400Khz
            //max-frequency = <50000000>; // 50Mhz
            //max-frequency = <45000000>; // 45Mhz
            //max-frequency = <40000000>; // 40Mhz
            //max-frequency = <35000000>; // 35Mhz
            //max-frequency = <30000000>; // 30Mhz
            max-frequency = <25000000>; // 25Mhz
            //max-frequency = <20000000>; // 20Mhz
            //max-frequency = <15000000>; // 15Mhz
            //max-frequency = <10000000>; // 10Mhz
            //max-frequency = <5000000>; // 5Mhz
            64_addressing;
            reset_tx_rx_phy;
            non-removable;
            pll_index = <0x7>;
            pll_reg = <0x300207C>;
            no-mmc;
            no-sd;
            status = "okay";
            interrupts = <38 IRQ_TYPE_LEVEL_HIGH>;
            interrupt-parent = <&plic0>;
      };
};

&wifisd {
	status = "okay";
};

&wifi_pin {
	poweron-gpio = <&portb 22 GPIO_ACTIVE_HIGH>;
	wakeup-gpio = <&porte 0 GPIO_ACTIVE_HIGH>;
};

&mipi_rx {
	snsr-reset = <&porta 18 GPIO_ACTIVE_LOW>, <&porta 20 GPIO_ACTIVE_LOW>;
};

&i2c1 {
	clock-frequency = <100000>;
	status = "okay";
};

&i2c2 {
	clock-frequency = <100000>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
    
      lsm6dsr: lsm6dsr@6a {
            compatible = "st,lsm6dsr";
            reg = <0x6a>;
            interrupt-parent = <&porte>;
            interrupts = <8 IRQ_TYPE_EDGE_RISING>;
      };

      atecc608a: atecc608a@60 {
            compatible = "sferalabs,atecc";
            reg = <0x60>;
            status = "okay";
      };
};

&i2c3 {
	clock-frequency = <100000>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
};

&i2c4 {
	clock-frequency = <100000>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	
	sw42000_sub: sw42000_sub@28 {
            status = "ok";
            compatible = "lge_sub,sw42000_sub";

            reg = <0x28>;
            interrupt-parent = <&porta>;
            interrupts = <3 IRQ_TYPE_EDGE_FALLING>;
            irqflags = <IRQ_TYPE_EDGE_FALLING>;

            reset-gpio = <&porta 2 GPIO_ACTIVE_LOW>;
            irq-gpio = <&porta 3 GPIO_ACTIVE_LOW>;

            /* Caps */
            max_x = <1080>;
            max_y = <1240>;
            max_pressure = <0xff>;
            max_width_major = <1080>;
            max_width_minor = <1240>;
            max_orientation = <90>;
            max_id = <10>;
            hw_reset_delay = <40>;
            sw_reset_delay = <40>;

            /* role */
            use_lpwg = <1>;
            use_lpwg_test = <1>;
            hide_coordinate = <1>;
            use_activepen_status = <0>;
            use_film_status = <1>;
            use_dex_mode = <1>;

            /* Firmware */
            fw_image = "touch/winglm/V1W39WING_v0.18.img";
            panel_spec = "touch/winglm/wing_sw42000_limit.txt";
            panel_spec_mfts_folder = "touch/winglm/wing_sw42000_limit.txt";

            /* Performance Test */
            use_perf_test = <1>;
            test_delay = <8>;
            test_pressure = <50>;
            test_width = <100>;
            click_test_x = <180>;
            click_test_y = <838>;
            v_drag_test_x = <144>;
            v_drag_test_start_y = <2103>;
            v_drag_test_end_y = <1216>;
            h_drag_test_start_x = <1163>;
            h_drag_test_end_x = <276>;
            h_drag_test_y = <2284>;
    };
};

&mipi_tx {
	reset-gpio = <&porta 0 GPIO_ACTIVE_LOW>;
	pwm-gpio = <&portb 19 GPIO_ACTIVE_HIGH>;
	power-ct-gpio = <&porte 12 GPIO_ACTIVE_HIGH>;
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&uart4 {
	status = "okay";
};

#if (CVIMMAP_FRAMEBUFFER_SIZE > 0)
&fb_reserved{
	alloc-ranges = <0x0 CVIMMAP_FRAMEBUFFER_ADDR 0 0xfd2000>;
	size = <0x0 0xfd2000>;
};
#endif
